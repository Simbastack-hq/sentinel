# Sentinel config. Copy to config/sentinel.env (gitignored) and adjust.
# Loaded as DEFAULTS by lib/common.sh — any env var set by the caller wins.
SENTINEL_HOME="$HOME/sentinel"

# --- Notifications (ntfy) ---
# Set a long, random, private topic (ntfy topics are public-by-name). Leave empty to disable pushes.
NTFY_SERVER="https://ntfy.sh"
NTFY_TOPIC=""
ENABLE_NOTIFY=1

# --- Scheduler ---
SCHEDULER_INTERVAL=900        # seconds between `sentinel tick` runs (launchd StartInterval)

# --- Guardrails ---
RUN_WALL_TIMEOUT=1800         # seconds, hard cap per agent run
CMD_TIMEOUT=900               # seconds, per external command (codex/claude/pi/setup)
MAX_REVIEW_DIFF_CHARS=40000   # truncate diffs larger than this before sending to a model

# --- review agent ---
REVIEW_ENGINE=pi              # pi (Mimo, fast+cheap, default) | codex (gpt-5.5, deeper but minutes) | claude
REVIEW_THINKING=low           # thinking level when REVIEW_ENGINE=pi
REVIEW_LOOKBACK=6             # commits to review on first run (no prior state)
REVIEW_TIMEOUT=240            # hard cap (s) on a review model call so a stall never blocks the scheduler
CODEX_MODEL=gpt-5.5
ENABLE_REVIEW_PR_COMMENT=0    # if 1 and target has an open PR for HEAD's branch, post the review there too

# --- docs-sync agent ---
DOCS_ENGINE=claude            # claude (needs edit capability in an isolated worktree)
CLAUDE_PERMISSION_MODE=acceptEdits
ENABLE_DOCS_PR=0             # 0 = save a patch + report (local); 1 = push branch + open PR (never merges)

# --- brain-sync agent ---
# The SHARED team knowledge repo (Simbastack-hq/simbastack-brain). brain-sync distills IMPORTANT
# changes from each watched repo's diff into one per-repo file there, as a PR. NEVER auto-merges.
# These are GLOBAL (one brain for all targets), not per-target. brain-sync skips cleanly if BRAIN_PATH
# is unset or not a git repo, so leave blank until you've cloned the brain locally.
BRAIN_PATH=""                                   # absolute path to a local clone of simbastack-brain (e.g. $HOME/simbastack-brain)
BRAIN_GITHUB="Simbastack-hq/simbastack-brain"   # owner/repo for `gh pr create` (must match the clone's origin)
BRAIN_BASE="main"                               # base branch PRs target
ENABLE_BRAIN_PR=0                               # 0 = save a patch + report (local, dry-run); 1 = push branch + open PR (never merges)
MAX_BRAIN_DIFF_CHARS=80000                      # above this, send a stat + commit-log summary (window still recorded, never silently dropped)
BRAIN_MIN_DIFF_LINES=8                          # skip the distill+PR when a window has fewer non-noise changed lines (avoids churn on trivial commits)

# --- qa agent ---
QA_ENGINE=node-loop           # node-loop (v1: deterministic Node loop, toolless Mimo) | pi-native (v2: Mimo drives via pi's agent loop + browser tools)
QA_PROVIDER=xiaomi            # pi provider for QA decisions/flow-derivation (configure the provider in pi itself, e.g. 'openrouter')
QA_MODEL=mimo-v2.5-pro
QA_THINKING=medium
QA_HEADLESS=1
# Vision UI/UX pass — any OpenAI-compatible endpoint. Defaults to Xiaomi/Mimo; uncomment to route via OpenRouter:
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_MODEL=...                 # an OpenRouter vision/multimodal model id
# VISION_API_KEY=sk-or-...         # OpenRouter key (else falls back to XIAOMI_API_KEY / ~/.pi/agent/auth.json)
# VISION_HTTP_REFERER=...          # optional OpenRouter attribution
# VISION_TITLE=Sentinel            # optional OpenRouter attribution

# --- global ---
DRY_RUN=0
