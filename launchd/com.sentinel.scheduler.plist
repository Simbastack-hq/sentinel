<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. `sentinel install` substitutes __SENTINEL_HOME__/__INTERVAL__/__PATH__ and loads it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sentinel.scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec "__SENTINEL_HOME__/bin/sentinel" tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
    <key>SENTINEL_HOME</key><string>__SENTINEL_HOME__</string>
  </dict>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>RunAtLoad</key><false/>
  <key>WorkingDirectory</key><string>__SENTINEL_HOME__</string>
  <key>StandardOutPath</key><string>__SENTINEL_HOME__/var/scheduler.log</string>
  <key>StandardErrorPath</key><string>__SENTINEL_HOME__/var/scheduler.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>
</dict>
</plist>
